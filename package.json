{
  "name": "fursim",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive 3D WebGL2/GPGPU fur physics and Marschner hair shading simulation for a stylized creature across studio, nature, and live AR camera environments.",
  "scripts": {
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "dev": "tsx server.ts",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "build": "vite build",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit",
    "start": "node server.ts",
    "test": "node adversarial_assessor.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^5.3.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.62.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.169.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
